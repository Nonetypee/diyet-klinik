# =============================================================
# Veritabanı (SQLite — kurulum gerektirmez)
# =============================================================
DATABASE_URL="file:./dev.db"

# =============================================================
# NextAuth (Auth.js v5)
# =============================================================
# Üretimde mutlaka rastgele 32+ karakter ile değiştirin
# Üretmek için:  openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me-please-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Seed sırasında oluşturulacak admin (npm run db:seed)
ADMIN_EMAIL="admin@diyetklinik.com"
ADMIN_PASSWORD="admin1234"

# =============================================================
# MESAJLAŞMA — WhatsApp birincil, SMS yedek (öneri)
# =============================================================
# WhatsApp'ı birincil yapın: SMS'in ~1/2 fiyatı
MESSAGING_PROVIDER="MOCK"          # WHATSAPP | NETGSM | MUTLUCELL | MOCK
MESSAGING_FALLBACK_PROVIDER=""     # WhatsApp başarısız olursa: NETGSM veya MUTLUCELL

# WhatsApp Cloud API (Meta)
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_PHONE_NUMBER_ID=""        # Meta'dan alınan numara ID
WHATSAPP_ACCESS_TOKEN=""           # Sistem kullanıcı / kalıcı token
WHATSAPP_API_VERSION="v22.0"

# Netgsm (Türkiye)
NETGSM_USERCODE=""
NETGSM_PASSWORD=""
NETGSM_HEADER=""                   # Onaylı gönderici adı, örn: BESLENME

# Mutlucell (Türkiye)
MUTLUCELL_USERNAME=""
MUTLUCELL_PASSWORD=""
MUTLUCELL_ORGN=""

# Geriye uyumluluk: eski SMS_PROVIDER değişkeni hâlâ destekleniyor
# (yeni MESSAGING_PROVIDER tercih edilir)
SMS_PROVIDER=""

# =============================================================
# Klinik
# =============================================================
DEFAULT_CLINIC_SLUG="diyet-klinik"
