# =============================================================
# Diyet Klinik — Çevre Değişkenleri
#
# Bu dosyayı `.env` olarak kopyalayın ve değerleri güncelleyin:
#   cp .env.example .env
#
# ÖNEMLİ: .env dosyası git'e commit EDİLMEMELİDİR (.gitignore'da)
# =============================================================

# -------------------------------------------------------------
# VERİTABANI (SQLite — kurulum gerektirmez)
# -------------------------------------------------------------
# Geliştirme:    file:./dev.db
# Üretim VPS:    file:/var/www/diyet-klinik/prisma/dev.db   (mutlak yol)
DATABASE_URL="file:./dev.db"


# -------------------------------------------------------------
# NEXTAUTH / AUTH.JS v5
# -------------------------------------------------------------
# Şifreleme ve JWT imzalama anahtarı. EN AZ 32 KARAKTER, RASTGELE.
# Üretmek için:  openssl rand -base64 32
#
# UYARI: Bu değer değişirse:
#   - Tüm mevcut oturumlar geçersiz olur
#   - Şifrelenmiş messaging credentials çözülemez → tekrar girilmeli
NEXTAUTH_SECRET="lutfen-bu-degeri-openssl-rand-base64-32-ile-uretin"

# Sitenizin tam URL'si. Üretimde HTTPS dahil:
#   NEXTAUTH_URL="https://selinakar.com.tr"
NEXTAUTH_URL="http://localhost:3000"

# Reverse proxy arkasında trustHost gerekli (Nginx / Cloudflare / Amplify)
AUTH_TRUST_HOST=true


# -------------------------------------------------------------
# İLK ADMIN HESABI (sadece `npm run db:seed` çalıştırırken)
# -------------------------------------------------------------
# Üretimde seed çalıştırıldıktan sonra bu değerleri değiştirin veya silin.
ADMIN_EMAIL="admin@diyetklinik.com"
ADMIN_PASSWORD="lutfen-guclu-bir-sifre-belirleyin"


# -------------------------------------------------------------
# KLİNİK
# -------------------------------------------------------------
DEFAULT_CLINIC_SLUG="diyet-klinik"


# =============================================================
# MESAJLAŞMA SAĞLAYICILARI
# =============================================================
# NOT: Artık bu değerleri .env'e yazmaya GEREK YOK!
# Admin panel → Ayarlar → Mesajlaşma sekmesinden girilebilir.
#
# Buradaki değerler sadece DB'de henüz config yoksa FALLBACK olarak
# kullanılır. Admin panel'den girilen değerler şifrelenerek DB'de saklanır
# ve önceliklidir.
# -------------------------------------------------------------

# Birincil: MOCK | WHATSAPP | NETGSM | MUTLUCELL
MESSAGING_PROVIDER="MOCK"

# Yedek (opsiyonel)
MESSAGING_FALLBACK_PROVIDER=""

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v22.0"

# Netgsm (Türkiye)
NETGSM_USERCODE=""
NETGSM_PASSWORD=""
NETGSM_HEADER=""

# Mutlucell (Türkiye)
MUTLUCELL_USERNAME=""
MUTLUCELL_PASSWORD=""
MUTLUCELL_ORGN=""
