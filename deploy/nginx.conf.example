################################################################
# Nginx Reverse Proxy — Diyet Klinik
#
# Kurulum:
#   1. Bu dosyayı /etc/nginx/sites-available/diyet-klinik kopyala
#   2. selinakar.com.tr yerine kendi domain'ini yaz (3 yerde)
#   3. /etc/nginx/sites-enabled/'a symlink ekle:
#        sudo ln -s /etc/nginx/sites-available/diyet-klinik \
#                   /etc/nginx/sites-enabled/diyet-klinik
#   4. sudo nginx -t          # syntax kontrol
#   5. sudo systemctl reload nginx
#
# SSL kurulumu (sonra):
#   sudo apt install certbot python3-certbot-nginx
#   sudo certbot --nginx -d selinakar.com.tr -d www.selinakar.com.tr
#
# Certbot bu dosyayı otomatik düzenleyip 443 bloğu ekler ve sertifikayı
# 90 günde bir cron ile yeniler.
################################################################

# Rate limiting — randevu formu spam'ini önler
limit_req_zone $binary_remote_addr zone=appointments:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name selinakar.com.tr www.selinakar.com.tr;

    # HTTPS varsa otomatik yönlendirme certbot tarafından eklenecek
    # Geçici olarak Let's Encrypt validation için /.well-known yolu açık kalsın
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    # Geri kalan tüm trafik Node.js'e
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # WebSocket / Server-Sent Events için
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Gerçek client bilgisini app'e ilet
        # Bu proxy header'ları auth.config.ts'deki publicOriginFromRequest()
        # fonksiyonunu doğru host'u almak için bekler.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Randevu API'sine spam koruması (dakikada 10 talep)
    location /api/appointments {
        limit_req zone=appointments burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Next.js statik asset'leri için uzun cache
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 200 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Yükleme boyutu limiti (CSV/yedek import'ları için)
    client_max_body_size 20M;

    # Güvenlik header'ları
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Sıkıştırma
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        application/javascript
        application/json
        application/xml
        text/css
        text/javascript
        text/plain
        text/xml
        image/svg+xml;

    # Access log
    access_log /var/log/nginx/diyet-klinik-access.log;
    error_log /var/log/nginx/diyet-klinik-error.log warn;
}
