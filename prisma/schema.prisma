// Diyet Klinik - Prisma Schema (SQLite)
// Tek diyetisyenli klinik için onay tabanlı randevu yönetim sistemi
// SQLite kullanılıyor: kurulum gerektirmez, dosya tabanlı (./prisma/dev.db)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// KLİNİK BİLGİSİ — tek satır (single-tenant)
// ============================================================

model Clinic {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  tagline       String?

  // İletişim
  phone         String
  whatsapp      String?
  email         String
  address       String
  city          String
  district      String
  mapUrl        String?

  // Çalışma saatleri (JSON string)
  workingHours  String    // JSON serialize edilmiş

  // KVKK
  kvkkText      String

  // SEO
  metaTitle     String?
  metaDescription String?
  keywords      String?

  // İlişkiler
  services      Service[]
  appointments  Appointment[]
  testimonials  Testimonial[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([slug])
}

// ============================================================
// DİYETİSYEN — tek kişi
// ============================================================

model Dietician {
  id            String    @id @default(cuid())
  fullName      String
  title         String    // "Dyt.", "Uzm. Dyt."
  specialty     String    // "Klinik Beslenme & Diyetetik"
  bio           String

  yearsOfExperience Int?
  licenseNumber String?
  photoUrl      String?

  appointments  Appointment[]

  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================================
// HİZMETLER
// ============================================================

model Service {
  id            String    @id @default(cuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // SLUG — formdan gelen stabil tanımlayıcı (örn: "kilo-yonetimi")
  slug          String    @unique
  name          String
  iconName      String    // Lucide icon: "Scale", "Leaf", "Salad"
  description   String
  durationMin   Int       @default(45)
  priceFromTRY  Int?
  category      String    // "WEIGHT", "SPORTS", "MEDICAL", "LIFESTYLE"

  appointments  Appointment[]

  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([category])
}

// ============================================================
// RANDEVU - Onay-Öncelikli
// ============================================================

model Appointment {
  id            String    @id @default(cuid())

  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id])

  dieticianId   String?
  dietician     Dietician? @relation(fields: [dieticianId], references: [id])

  serviceId     String
  service       Service   @relation(fields: [serviceId], references: [id])

  // Hasta Bilgileri
  patientName   String
  patientPhone  String
  patientEmail  String?
  patientNote   String?

  // Randevu Detayları
  requestedAt   DateTime
  approvedAt    DateTime?

  // status: PENDING | APPROVED | REJECTED | COMPLETED | CANCELLED | NO_SHOW
  // SQLite enum'u native desteklemediği için string olarak tutulur
  status        String    @default("PENDING")

  // Onay Süreci
  approvedBy    String?
  rejectionReason String?
  alternativeSlot DateTime?

  // KVKK Onayı
  kvkkConsent   Boolean   @default(false)
  kvkkConsentAt DateTime?

  // SMS Logları
  smsLogs       SmsLog[]

  // Meta
  source        String    @default("WEB")
  ipAddress     String?
  userAgent     String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clinicId, status])
  @@index([requestedAt])
  @@index([patientPhone])
}

// Status sabit değerleri için exportable type tanımı (TS tarafında kullanılır)
// "PENDING" | "APPROVED" | "REJECTED" | "COMPLETED" | "CANCELLED" | "NO_SHOW"

// ============================================================
// SMS İZLEME
// ============================================================

model SmsLog {
  id            String    @id @default(cuid())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  // "MOCK" | "NETGSM" | "MUTLUCELL" | "TWILIO"
  provider      String
  toPhone       String
  message       String

  // "QUEUED" | "SENT" | "DELIVERED" | "FAILED"
  status        String    @default("QUEUED")

  providerMessageId String?
  errorMessage  String?
  cost          Float?

  sentAt        DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([appointmentId])
  @@index([status])
}

// ============================================================
// SOSYAL KANIT
// ============================================================

model Testimonial {
  id            String    @id @default(cuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  patientName   String
  rating        Int
  comment       String
  service       String?
  result        String?   // "8 kg kayıp - 4 ayda"
  isVerified    Boolean   @default(false)
  isFeatured    Boolean   @default(false)

  createdAt     DateTime  @default(now())
}

// ============================================================
// ADMIN KULLANICILARI
// ============================================================

// ============================================================
// MESAJLAŞMA YAPILANDIRMASI
// Admin panelinden düzenlenebilen WhatsApp / SMS sağlayıcı ayarları.
// Hassas alanlar (token, şifre) AES-256-GCM ile şifrelenmiş olarak
// "...Enc" sufix'iyle saklanır.
// ============================================================

model MessagingConfig {
  id String @id @default("singleton") // Sadece 1 satır

  // Birincil sağlayıcı: MOCK | WHATSAPP | NETGSM | MUTLUCELL
  primaryProvider  String  @default("MOCK")
  // Yedek (opsiyonel): birincil başarısız olursa
  fallbackProvider String?

  // WhatsApp Cloud API
  whatsappPhoneNumberId  String?
  whatsappAccessTokenEnc String?
  whatsappApiVersion     String? @default("v22.0")

  // Netgsm
  netgsmUserCode    String?
  netgsmPasswordEnc String?
  netgsmHeader      String?

  // Mutlucell
  mutlucellUsername    String?
  mutlucellPasswordEnc String?
  mutlucellOrgn        String?

  // Son test mesajının sonucu (UI'da göster)
  lastTestAt        DateTime?
  lastTestStatus    String?  // OK | FAILED
  lastTestChannel   String?
  lastTestError     String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ============================================================
// ANASAYFA İÇERİĞİ
// Tüm landing page metinleri ve marka renkleri. Singleton kayıt.
// JSON alanlar (pillars, stats, steps, faqs, trustSignals) admin panelde
// repeater UI ile düzenlenir.
// ============================================================

model LandingContent {
  id String @id @default("singleton")

  // Marka Renkleri (CSS değişkenleri olarak yayılır)
  primaryColor    String  @default("#047857") // emerald-700 → ana vurgu
  primaryColorDark String @default("#065f46") // emerald-800 → koyu varyant
  accentColor     String  @default("#14b8a6") // teal-500   → ikinci vurgu
  darkBgColor     String  @default("#064e3b") // emerald-900 → CTA arkaplan

  // Hero
  heroBadge       String @default("Bilime dayalı, kişiye özel beslenme")
  heroTitlePart1  String @default("Sağlıklı yaşam,")
  heroTitleAccent String @default("sürdürülebilir")
  heroTitlePart2  String @default("beslenme alışkanlığıyla başlar.")
  heroSubtitle    String @default("Yo-yo diyetlerine veda. Yaşam tarzınıza, hedefinize ve laboratuvar değerlerinize göre kişiselleştirilmiş, bilim temelli bir beslenme planıyla kalıcı sonuçlara birlikte ulaşalım.")
  heroCtaPrimary   String @default("Hemen Randevu Talep Et")
  heroCtaSecondary String @default("Hizmetlerimi İnceleyin")
  // JSON: [{ icon: "ShieldCheck", text: "KVKK Uyumlu" }, ...]
  heroTrustSignals String @default("[]")

  // Trust Builder
  trustBadge    String @default("Neden Beni Seçmelisiniz?")
  trustTitle    String @default("Sürdürülebilir sonuç,\nşeffaf süreç.")
  trustSubtitle String @default("Yo-yo diyetler ve genel-geçer öneriler size zaman kaybettiriyor. Bilime dayalı, kişiye özel bir plan ile gerçek sağlık dönüşümü mümkün.")
  // JSON: [{ icon: "FlaskConical", title, description }]
  trustPillars  String @default("[]")
  // JSON: [["1.500+", "Memnun danışan"], ...]
  trustStats    String @default("[]")

  // Services bölümü başlık
  servicesBadge    String @default("Hizmetlerim")
  servicesTitle    String @default("Her hedef için, kişiye özel bir plan.")
  servicesSubtitle String @default("Kilo yönetiminden sporcu beslenmesine, hamilelik dönemine ve hastalık bazlı medikal beslenmeye uzanan kapsamlı bir uzmanlık.")

  // How It Works
  howBadge    String @default("Nasıl Çalışır?")
  howTitle    String @default("Onay-öncelikli, şeffaf bir akış")
  howSubtitle String @default("Otomatik onay yerine her randevu titizlikle kontrol edilir. Hata payı yoktur, çakışma yaşanmaz.")
  // JSON: [{ number, icon, title, description }]
  howSteps    String @default("[]")

  // Randevu bölümü (form üstü)
  bookingBadge    String @default("Randevu Talebi")
  bookingTitle    String @default("Sağlıklı yaşam için ilk adımı atın")
  bookingSubtitle String @default("Formu doldurun, en kısa sürede randevunuzu değerlendireyim. Onaylandığında bilgilendirileceksiniz.")

  // FAQ
  faqBadge String @default("Sıkça Sorulan Sorular")
  faqTitle String @default("Aklınıza takılanlar")
  // JSON: [{ q, a }]
  faqItems String @default("[]")

  // CTA
  ctaTitle    String @default("Sağlıklı yaşam için\nbekleyecek vaktiniz yok.")
  ctaSubtitle String @default("Randevu sürecinizi 60 saniyede tamamlayın. Onayım SMS ile size ulaşacak, sürdürülebilir değişim yolculuğunuz başlayacak.")
  ctaPrimary  String @default("Randevu Talep Et")

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          String    @default("SECRETARY") // SUPER_ADMIN | DIETICIAN | SECRETARY
  isActive      Boolean   @default(true)

  // TOTP / 2FA — RFC 6238
  totpSecret      String?   // Base32-encoded shared secret (otplib)
  totpEnabled     Boolean   @default(false)
  totpVerifiedAt  DateTime?
  // Tek kullanımlık yedek kodlar (JSON: [{ hash, used, usedAt }])
  // hash bcrypt ile üretilir, kod kaybolursa giriş için kullanılır
  backupCodes     String?

  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
