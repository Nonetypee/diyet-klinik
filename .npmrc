# npm 9+ varsayılanları yeterli — peer dependency'leri otomatik yönetir.
# Eğer install sırasında çakışma yaşarsanız aşağıdaki satırı aktif edin:
# legacy-peer-deps=true

# Funding mesajlarını gizle (bilgi spam'i)
fund=false

# Audit raporunda 'moderate' ve üstü uyarıları göster
audit-level=moderate
